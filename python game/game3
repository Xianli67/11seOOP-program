import random, time


class Fighter:
    def __init__(self, name, health, weapon, shield, exp, level = 1,):
        self.name = name
        self.health = health
        self.max_health = health
        self.weapon = weapon
        self.shield = shield
        self.exp = exp
        self.level = level
        self.chosen = False

    # Displays health depending on whether it's the player or enemy
    def report(self):
        if self.name == 'You':
            return print('Your health:' + str(self.health))
        else:
            return print(self.name + ' ' + 'health:' + str(self.health))
    
    # Handles leveling system and stat increases, checks wether xp is enough to increase level, once level is increased, 
    def level_check(self):
        required_exp = 100 + (self.level - 1) * 50
        while self.exp >= required_exp:
            self.exp -= required_exp
            required_exp = 100 + (self.level) * 20
            self.level += 1
            self.weapon += 5
            self.shield += 2
            self.max_health += 10 

            print(f"{self.name} leveled up to level {self.level}! \n + 5 attack power \n + 10 max hp \n + 2 defense")

    # Handles class selection at level 5+, if level is greater than 5 you are able to choose a class
    def class_selection_check(self):
        if self.level >= 5 and not self.chosen:
            health = self.max_health
            attack_power = self.weapon
            defense = self.shield
            exp = self.exp
            level = self.level
            self.chosen = True
            time.sleep(1)
            print('Since you have leveled up to level ' + str(self.level))  
            time.sleep(1)
            print('You now have the option to fight the forest boss')
            time.sleep(2)
            print('You are also now able to choose a class')   
            time.sleep(2)
            build = input('m to choose melee, t to choose tank, j to choose jester')

            while build not in ['m', 't', 'j']:
                build = input('m to choose melee, t to choose tank, j to choose jester')

            if build == 'm':
                you = Melee('You', self.health, attack_power, defense, exp, level)
                you.max_health = self.max_health
                you.chosen = True
                time.sleep(1)
                print('you have chosen Melee')
                time.sleep(1)
                print('you are now able to use rage in combat')
                time.sleep(2)
                print('rage multipies your attack power by 2 but you have limited uses')
                time.sleep(3)
                print('you can see your number of uses in your player stats')
                time.sleep(2)
                return you

            elif build == 't':
                you = tank('You', health, attack_power, defense, exp, level)
                you.chosen = True
                print('you have chosen tank')
                return you

            elif build == 'j':
                you = jester('You', health, attack_power, defense, exp, level)
                you.chosen = True
                print('you have chosen jester')
                return you

    #checks if either player or enemy is dead, simple enough
    def is_dead(self):
        if self.health <= 0:
            return True
        else:
            return False

    #gets a rnadom damage output so the damage isnt entirely fixed
    def random_attack(self):
        attack_power = int(self.weapon) + random.randint(-5, 5)
        return attack_power

    #handles player's input attacks
    def initiate_attack(self):
        fight_input = input('\npress enter to attack \nt for "tactical retreat"\n')
        if fight_input == 't':
            return 'b'
        else:
            attack_power = self.random_attack()
            #special melee ability check
            if isinstance(self, Melee):
                choice = input("Press r to use RAGE or enter to attack normally: ")
                if choice == 'r':
                    attack_power = self.use_rage(attack_power)
            return attack_power
    
    #calculates how much damage either party is receving
    def defend(self, attack_power):
        damage = attack_power - self.shield
        if damage > 0:
            self.health -= damage
            print('damage:', damage)
        else:
            print('no damage')


class Melee(Fighter):
    def __init__(self,name, health, weapon, shield, exp, level, rage = 5):
        super().__init__(name, health, weapon, shield, exp, level,)
        self.rage = rage

    def use_rage(self, attack_power):
        if self.rage > 0:
            self.rage -= 1
            time.sleep(1)
            print("You used an enraged attack, your attack power is doubled")
            time.sleep(2)
            return attack_power * 2
        else:
            print("No rage left!")
            return attack_power


class tank(Fighter):
    def __init__(self,name, health, weapon, shield, exp, level, blocks = 1):
        super().__init__(name, health, weapon, shield, exp, level)
        self.blocks = blocks


class jester(Fighter):
    def __init__(self,name, health, weapon, shield, exp, level, gambles = 2):
        super().__init__(name, health, weapon, shield, exp, level,)
        self.gambles = gambles


class forest(Fighter):
    def __init__(self,name, health, weapon, shield, exp, purification):
        super().__init__(name, health, weapon, shield, exp)
        self.purification = purification


class hell(Fighter):
    def __init__(self,name, health, weapon, shield, exp, eternal_flame):
        super().__init__(name, health, weapon, shield, exp)
        self.eternal_flame = eternal_flame


