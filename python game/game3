def enemy_spawn_forest():
    rng = random.randint(1, 30)

    if rng <= 10:
        return forest('slime', 30, 20, 0, 100, 6)

    elif rng <= 20:
        return forest('evil pig', 40, 30, 0, 120, 7)

    else:
        return forest('rotten bear', 50, 35, 0, 650, 8)
    
#spawns the enemies in the hell biome and helps keep the hell enemy spawn randomlized 
def enemy_spawn_hell():
    rng = random.randint(1, 30)

